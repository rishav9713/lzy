# Binary search: halve the problem until the answer is left.

function binary_search(sorted_items, wanted)
    low = 0
    high = length(sorted_items) - 1

    while low <= high
        middle = floor((low + high) / 2)
        found = sorted_items[middle]

        if found == wanted
            return middle
        else if found < wanted
            low = middle + 1
        else
            high = middle - 1

    return nothing

numbers = [1, 3, 5, 7, 9, 11, 13]

say binary_search(numbers, 7)
say binary_search(numbers, 1)
say binary_search(numbers, 13)
say binary_search(numbers, 8)
