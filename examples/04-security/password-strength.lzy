# Checking how strong a passphrase is, before it gets used.
#
# This gives advice to the person choosing the passphrase. It is not a
# password cracker, and it never stores or sends what it is given.

function classify(passphrase)
    findings = []

    if length(passphrase) < 12
        append(findings, "shorter than 12 characters")

    has_lower = false
    has_upper = false
    has_digit = false
    has_symbol = false

    digits = "0123456789"
    lower_letters = "abcdefghijklmnopqrstuvwxyz"
    upper_letters = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"

    for character in passphrase
        if contains(digits, character)
            has_digit = true
        else if contains(lower_letters, character)
            has_lower = true
        else if contains(upper_letters, character)
            has_upper = true
        else
            has_symbol = true

    kinds = 0
    if has_lower
        kinds = kinds + 1
    if has_upper
        kinds = kinds + 1
    if has_digit
        kinds = kinds + 1
    if has_symbol
        kinds = kinds + 1

    if kinds < 3
        append(findings, "mixes only " + text(kinds) + " kinds of character")

    # A handful of choices that show up in every breach list.
    well_known = ["password", "123456", "qwerty", "letmein", "admin", "welcome"]
    plain = lower(passphrase)
    for known in well_known
        if contains(plain, known)
            append(findings, "contains the very common word '" + known + "'")

    # A long passphrase made of ordinary words is genuinely strong, even
    # though it uses few kinds of character. Length wins over variety.
    only_complaint_is_variety = length(findings) == 1 and kinds >= 2
    if length(passphrase) >= 20 and only_complaint_is_variety
        findings = []

    return findings

samples = [
    "password1",
    "Tr0ub4dor&3",
    "correct horse battery staple",
    "aB3$",
    "qwerty123456"
]

for sample in samples
    hidden = ""
    for i in range(length(sample))
        hidden = hidden + "*"

    problems = classify(sample)

    if length(problems) == 0
        say hidden + "  (" + text(length(sample)) + " characters): looks strong"
    else
        say hidden + "  (" + text(length(sample)) + " characters):"
        for problem in problems
            say "    - " + problem
